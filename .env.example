# Скопируйте в .env (файл .env в git не попадает) и заполните.
# Ключ нужен только серверу; в браузер он не передаётся.
CLOUDRU_API_KEY=
# Имя модели из консоли Cloud.ru Foundation Models, например Qwen/... или GigaChat/...
CLOUDRU_MODEL=
# Необязательно: другой адрес OpenAI-совместимого API
# CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1
# Необязательно: модель эмбеддингов для поиска по смыслу в памяти (по умолчанию BAAI/bge-m3; меняется и в «Настройках»)
# CLOUDRU_EMBEDDING_MODEL=BAAI/bge-m3

# Обновление (необязательно)
# Токен GitHub только для чтения публичного репозитория: повышает лимит запросов при проверке обновлений.
# GITHUB_TOKEN=
# 0 — устанавливать версии и без зелёного CI на GitHub (для форка без проверок).
# JUUNIBI_UPDATE_REQUIRE_CI=1
