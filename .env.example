# Скопируйте в .env (файл .env в git не попадает) и заполните.
# Ключ нужен только серверу; в браузер он не передаётся.
CLOUDRU_API_KEY=
# Имя модели из консоли Cloud.ru Foundation Models, например Qwen/... или GigaChat/...
CLOUDRU_MODEL=
# Необязательно: другой адрес OpenAI-совместимого API
# CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1
